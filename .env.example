# Never commit a real key. The runtime stays in synthetic mode when empty.
BAIDU_MAP_AK=
# 网页道路底图：单独申请“浏览器端”AK，并设置 Referer 白名单。
# 浏览器AK会公开给网页；服务端AK不能填到这里。离线启动不读取此配置。
BAIDU_BROWSER_AK=
BAIDU_API_BASE_URL=https://api.map.baidu.com
BAIDU_PLACE_API_VERSION=v3
BAIDU_API_TIMEOUT=8
BAIDU_API_CACHE_TTL=300
BAIDU_API_MAX_PAGES=5
# 个人认证开发者的并发上限是 3 次/秒；默认按 2 次/秒发起请求，给持续运行留出余量。
# 企业认证（试用版 30 次/秒、授权版 200 次/秒）可上调，但仍需低于账号实际配额。
# 注意：地点检索在个人认证下只有 100 次/日，详见 docs/baidu-integration.md 的配额一节。
BAIDU_API_MAX_CONCURRENCY=3
# 检索词组画像，决定一次体检消耗几次地点检索。
# full（默认）= 10 次/体检，召回优先；narrow = 4 次/体检，配额优先，
# 保留菜市场/药店/小学（1 公里盲区）与养老，放弃子类细分。
# 个人认证（地点检索 100 次/日）建议用 narrow，否则每天只够 10 次完整体检。
BAIDU_POI_QUERY_PROFILE=full
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 兼容 Chat Completions 的接口使用 chat_completions；使用 Responses 的模型选择 responses。
# AI_BASE_URL 填 API 根路径（通常以 /v1 结尾），不含 /chat/completions 或 /responses。
AI_PROTOCOL=chat_completions
AI_TIMEOUT=45
AI_MAX_MAP_REQUESTS=64

# 强制 IPv4 出口：api.map.baidu.com 有 AAAA 记录，家宽 IPv6 出口不在 IP 白名单内时会报 APP IP 校验失败。置 0 关闭。
BAIDU_API_FORCE_IPV4=1

# QPS 节流：每秒计量单元上限（矩阵按路线对数加权）（默认 2，个人认证上限通常为 3）。在途并发由 BAIDU_API_MAX_CONCURRENCY 单独限制。
BAIDU_API_QPS=2

# 批量算路每请求路线对数：并发按对数计入（官方告警口径），默认 2 留出余量，企业认证可调高。
BAIDU_API_MATRIX_PAIRS=2

# 回放模式：指向 scripts/record_replay_fixtures.py 录制的 fixture 后，所有请求离线回放（live-replay 标注）。
# 留空为正常实时模式。fixture 含真实响应，只存 .runtime/，不入库。
BAIDU_REPLAY_FILE=
