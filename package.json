{
  "name": "neighborhood-circle",
  "version": "0.7.0",
  "private": true,
  "description": "Development checks for the standalone Python and browser app",
  "scripts": {
    "format": "prettier --write \"*.js\" \"*.css\" \"*.html\" \"tests/*.cjs\"",
    "format:check": "prettier --check \"*.js\" \"*.css\" \"*.html\" \"tests/*.cjs\"",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
